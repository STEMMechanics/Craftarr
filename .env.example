# Craftarr
# Upgrading from v0.3.3? Copy your existing STEMCRAFT_* values to the matching
# CRAFTARR_* names before updating. See docs/installation.md for the full steps.

# Web server
CRAFTARR_CONSOLE_HOST=127.0.0.1
CRAFTARR_CONSOLE_PORT=8000

# Optional identity shown in update emails. The public URL adds direct links
# back to the matching server page. These can also be set in App settings.
# CRAFTARR_INSTANCE_NAME=Production console
# CRAFTARR_PUBLIC_URL=https://console.example.com

# Optional IANA timezone for automation (defaults to the server's system timezone).
# Examples: Australia/Brisbane, Australia/Sydney, America/New_York
CRAFTARR_TIMEZONE=Australia/Brisbane

# Optional rclone config used by scheduled off-site backup copies.
# CRAFTARR_RCLONE_CONFIG=/etc/craftarr/rclone.conf
# CRAFTARR_RCLONE_TIMEOUT_SECONDS=3600

# Set true after the panel is served through HTTPS.
CRAFTARR_CONSOLE_COOKIE_SECURE=false

# Session signing
CRAFTARR_CONSOLE_SECRET=change-me

# Database
CRAFTARR_CONSOLE_DATABASE=craftarr.db

# Minecraft server storage
CRAFTARR_CONSOLE_SERVER_ROOT=minecraft-servers

# Optional persistent path for the shared plugin update settings repository.
# By default, the file is stored beside the database and starts from bundled defaults.
# CRAFTARR_PLUGIN_MONITORING_DEFAULTS=/etc/craftarr/plugin-monitoring.yml
