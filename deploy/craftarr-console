#!/usr/bin/env bash
set -euo pipefail

ORIGINAL_ARGS=("$@")

rerun_as_root() {
  local self_path
  self_path=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)
  [[ -n "$self_path" ]] || self_path=$(command -v -- "${BASH_SOURCE[0]}" 2>/dev/null || true)
  if [[ -z "$self_path" ]]; then
    echo "Unable to resolve the craftarr-console command path." >&2
    exit 1
  fi
  exec sudo -- "$self_path" "${ORIGINAL_ARGS[@]}"
}

usage() {
  cat <<'EOF'
Usage:
  craftarr-console {status|start|stop|restart|logs}
  craftarr-console reset-password [USERNAME]
  craftarr-console server NAME {status|start|stop|restart|logs}

The server NAME is the systemd service name configured in the panel.
EOF
}

run_unit_command() {
  local unit=$1
  local action=$2

  case "$action" in
    status) systemctl --no-pager --full status "$unit" ;;
    start|stop|restart)
      if [[ ${EUID} -ne 0 ]]; then
        rerun_as_root
      fi
      systemctl "$action" "$unit"
      ;;
    logs) journalctl -u "$unit" --no-pager -n 100 ;;
    *) usage >&2; exit 2 ;;
  esac
}

if [[ ${1:-} == reset-password ]]; then
  [[ $# -le 2 ]] || { usage >&2; exit 2; }
  if [[ ${EUID} -ne 0 ]]; then
    rerun_as_root
  fi
  username=${2:-admin}
  [[ "$username" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]] || {
    echo "Invalid username." >&2
    exit 2
  }
  cd /opt/craftarr
  exec runuser -u craftarr -- env \
    CRAFTARR_CONSOLE_ENV=/etc/craftarr/console.env \
    /opt/craftarr/.venv/bin/python -m app.admin_cli reset-password "$username"
elif [[ ${1:-} == server ]]; then
  [[ $# -eq 3 ]] || { usage >&2; exit 2; }
  name=$2
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$ ]] || {
    echo "Invalid server service name." >&2
    exit 2
  }
  server_unit="craftarr-server@${name}.service"
  run_unit_command "$server_unit" "$3"
elif [[ $# -eq 1 ]]; then
  run_unit_command craftarr-console.service "$1"
else
  usage >&2
  exit 2
fi
