[Unit]
Description=Craftarr Minecraft Server %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=craftarr
Group=craftarr
WorkingDirectory=/opt/craftarr
EnvironmentFile=-/etc/craftarr/console.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/craftarr/.venv/bin/python -m app.server_supervisor --service-name %i
Restart=on-failure
RestartSec=10
UMask=0027
LimitNOFILE=65536
RuntimeDirectory=craftarr
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
TimeoutStopSec=90
KillSignal=SIGTERM
# Signal the supervisor first. It translates SIGTERM into Minecraft's `stop`
# console command; Java is only force-killed if the graceful timeout expires.
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/craftarr /srv/minecraft /run/craftarr

[Install]
WantedBy=multi-user.target
